+package com.winlator.container;
+
+import android.os.Build;
+
+import java.util.Locale;
+
+/**
+ * Small device profile for safe first-run defaults. It does not change settings
+ * of containers that have already been created and saved.
+ */
+public final class DeviceProfile {
+    private DeviceProfile() {}
+
+    public static boolean isGalaxyA06() {
+        String model = Build.MODEL;
+        String device = Build.DEVICE;
+        return (model != null && model.toUpperCase(Locale.ROOT).startsWith("SM-A065"))
+                || "a06".equalsIgnoreCase(device);
+    }
+
+    public static String defaultScreenSize() {
+        return isGalaxyA06() ? "960x540" : "1280x720";
+    }
+}
